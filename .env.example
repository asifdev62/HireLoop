# Copy this file to .env and fill in real values.
# Never commit .env: it is already ignored by .gitignore.

# Better Auth
BETTER_AUTH_SECRET="generate a long random value, e.g. openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"

# MongoDB (the database name is fixed to hireloopdb in lib/auth.ts)
MONGODB_URL="mongodb+srv://USER:PASSWORD@CLUSTER/hireloopdb"

# Google OAuth (optional; the Google buttons are hidden when these are empty)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Express API. API_BASE_URL is server-only and preferred.
# NEXT_PUBLIC_API_BASE_URL is the legacy fallback and is visible to browsers.
API_BASE_URL="http://localhost:5000"
# NEXT_PUBLIC_API_BASE_URL="http://localhost:5000"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Only needed when the app runs behind a trusted reverse proxy.
TRUST_PROXY=0
